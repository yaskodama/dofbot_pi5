// planner_demo.aipl — the planner side, running on the reference implementation (Mac). It doesn't touch the arm (no io)
// and asks the Arm actor on the Xinu board via remote_call (net).
class Planner {
  method demo() : unit !{net, log} {
    var b = "192.168.3.101:9010";
    print("read : " ++ remote_call(b, "dofbot", "cmd", "read", 2000));
    print("led  : " ++ remote_call(b, "dofbot", "cmd", "rgb 0 0 255", 2000));
    print("pose : " ++ remote_call(b, "dofbot", "cmd", "pose 90 90 90 90 90 30 1500", 2000));
    print("base : " ++ remote_call(b, "dofbot", "cmd", "set 1 120 1000", 2000));
    print("back : " ++ remote_call(b, "dofbot", "cmd", "set 1 90 1000", 2000));
    print("count: " ++ remote_call(b, "dofbot", "served", "0", 2000));
  }
}
var p = new Planner();
send p.demo();
