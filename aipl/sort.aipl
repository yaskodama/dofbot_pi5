// sort.aipl — complex.aipl の改良版: 立方体を探して挟み、緑は右・青は左に置く。
// まず Mac の模型（127.0.0.1:9010）、次に実機（192.168.3.101:9010）。
//
// カメラは挟む所の上（手首の上面、指の軸から 3.2 cm）に付いている。指の軸を立方体に向けると
// カメラは立方体を外れる。そこで color_service.py（127.0.0.1:9012 の "Camera"）に:
//   locate … 腕をずらしてカメラの軸を立方体へ向けて撮り、色の塊の重心を卓上へ逆射影し、
//            カメラを向け直す、を収束まで繰り返す（locate.py）。答えは色（green|blue|none）。
//   get    … その立方体を挟む 土台の角度 / 手前 / 挟む 姿勢（逆運動学）。
// 挟めるまで繰り返す: 持ち上げたあとに指の読み戻しで挟めたか確かめ、挟めていなければ探し直して挟み直す。
// 指は 135 まで閉じる。実測の幅（2026-09-28）: 30,50→6.2 70→5.8 90→5.2 110→4.2 131→3.0 135→2.8 cm。3 cm の立方体は 131 で触れ、135 で 2 mm 押さえる。
// （110 では 4.2 cm 開いたままで、立方体に触れていなかった）
// 模型は CG の手首カメラ、実機は Xinu のカメラの画素で、同じ手順・同じ判定。
// 挟む・置くときは lower（color_service）で卓上 7 cm から 0.5 cm ずつ降ろし、模型の計算で卓上 2.8 cm で止める
// （模型で 2.3 cm まで下げると実機は卓に当たって本体が浮いた。実機の指は模型より長い）。
// 置き場は土台 150°（右）/ 30°（左）の前 17 cm。
class Dancer {
  // 腕へ 1 手送る。前後で PLAN（color_service の "Plan"）に積んで結果を書き戻す
  // → Xinu シミュレータの CG に命令の列が出て、いま実行中の手が反転する。
  method go(b: string, s: string) : int !{net, log} {
    var where = "real";
    if (b == "127.0.0.1:9010") { where = "sim"; }
    var i = remote_call("127.0.0.1:9012", "Plan", "push", where ++ " " ++ s, 2000);
    var res = remote_call(b, "dofbot", "cmd", s, 3000);
    var z = remote_call("127.0.0.1:9012", "Plan", "done", i ++ " " ++ res, 2000);
    print("  " ++ s ++ "  -> " ++ res);
    reply(0);
  }
}
class Eye {
  method locate(mode: string, grip: string) : string !{net, log} {
    var c = remote_call("127.0.0.1:9012", "Camera", "locate", mode ++ " " ++ grip, 60000);
    print("  locate(" ++ mode ++ ", grip " ++ grip ++ ") = " ++ c);
    reply(c);
  }
  method lower(mode: string, arg: string) : string !{net, log} {
    var v = remote_call("127.0.0.1:9012", "Camera", "lower", mode ++ " " ++ arg, 45000);
    print("  lower(" ++ arg ++ ") = " ++ v);
    reply(v);
  }
  method held(mode: string) : string !{net, log} {
    var v = remote_call("127.0.0.1:9012", "Camera", "held", mode, 8000);
    print("  held(" ++ mode ++ ") = " ++ v);
    reply(v);
  }
  method get(mode: string, key: string) : string !{net, log} {
    var v = remote_call("127.0.0.1:9012", "Camera", "get", mode ++ " " ++ key, 5000);
    print("  " ++ key ++ " = " ++ v);
    reply(v);
  }
}
class Planner {
  method sort(d: Dancer, e: Eye, b: string, mode: string) : int !{net, time, log} {
    var r = 0;
    r = now d.go(b, "pose 90 90 90 90 90 30 1500") timeout 5000 else 0; wait(1750);          // 直立
    var c = now e.locate(mode, "30") timeout 90000 else "none";                                   // 立方体を探す（腕も動く）
    var color = c;
    var tries = 0;
    var base = "90";
    // 挟めるまで繰り返す（上限 30 回）。挟めたかは、持ち上げたあとに指（サーボ6）の読み戻しで確かめる:
    // 135 で閉じて 3 cm の立方体を挟めば指は 131 前後で止まる（held_max=133 以下）。空なら 135 まで閉じ切る。
    // （以前は卓上を探し直して「見えない＝挟めた」としていたが、押されて視野の外に出ただけでも成功扱いになった）
    while tries < 30 do {
      if (c == "none") {
        print("  try " ++ (tries + 1) ++ ": no cube in view — look again");
        c = now e.locate(mode, "30") timeout 90000 else "none";
        if (c != "none") { color = c; }
        tries = tries + 1;
      } else {
        base = now e.get(mode, "base") timeout 8000 else "90";
        var pre = now e.get(mode, "pre") timeout 8000 else "59 35 10";
        var grasp = now e.get(mode, "grasp") timeout 8000 else "50 27 28";
        print("  try " ++ (tries + 1) ++ ": grasp at base " ++ base);
        r = now d.go(b, "set 6 30 500") timeout 5000 else 0; wait(700);                                        // 指を開く
        r = now d.go(b, "pose " ++ base ++ " 80 50 50 90 30 1200") timeout 5000 else 0; wait(1450);          // 構え（P_TOP）
        var y = now e.lower(mode, "here 30") timeout 60000 else "err";                                         // 立方体の上から 0.5 cm ずつ降ろす
        if (y == "err") {
          print("  try " ++ (tries + 1) ++ ": could not lower (" ++ y ++ ") — look again");
          r = now d.go(b, "pose " ++ base ++ " 80 50 50 90 30 1200") timeout 5000 else 0; wait(1450);
          c = now e.locate(mode, "30") timeout 90000 else "none";
          if (c != "none") { color = c; }
          tries = tries + 1;
        } else {
        r = now d.go(b, "set 6 135 600") timeout 5000 else 0; wait(850);                                       // 挟む
        r = now d.go(b, "pose " ++ base ++ " " ++ pre ++ " 90 135 1000") timeout 5000 else 0; wait(1250);    // 軸に沿って上がる
        r = now d.go(b, "pose " ++ base ++ " 80 50 50 90 135 1200") timeout 5000 else 0; wait(1450);         // 持ち上げる（P_TOP）
        var h = now e.held(mode) timeout 15000 else "err";                                                     // 指が物に当たって止まっているか
        if (h == "yes") {
          print("  try " ++ (tries + 1) ++ ": the fingers stopped on the cube — it is in the hand");
          tries = 1000;
        } else {
          print("  try " ++ (tries + 1) ++ ": the fingers closed on nothing — open, look again, try again");
          r = now d.go(b, "set 6 30 500") timeout 5000 else 0; wait(700);
          c = now e.locate(mode, "30") timeout 90000 else "none";
          if (c != "none") { color = c; }
          tries = tries + 1;
        }
        }
      }
    }
    if (tries < 1000) {
      print("  gave up after 30 tries");
      r = now d.go(b, "set 6 30 500") timeout 5000 else 0; wait(700);
      r = now d.go(b, "pose 90 90 90 90 90 30 1500") timeout 5000 else 0; wait(1750);
      reply(0);
    } else {
      var at = 30;
      if (color == "green") { at = 150; print("  green -> right"); } else { print("  blue -> left"); }
      r = now d.go(b, "pose " ++ at ++ " 80 50 50 90 135 1500") timeout 5000 else 0; wait(1750);   // 置き場へ回す
      var y2 = now e.lower(mode, at ++ " 17 135") timeout 60000 else "err";                     // 置き場へ 0.5 cm ずつ降ろす
      r = now d.go(b, "set 6 30 600") timeout 5000 else 0; wait(850);                               // 放す
      r = now d.go(b, "pose " ++ at ++ " 59 35 10 90 30 1000") timeout 5000 else 0; wait(1250);    // 軸に沿って上がる
      r = now d.go(b, "pose 90 90 90 90 90 30 1800") timeout 5000 else 0; wait(2050);               // 直立に戻る
      reply(at);
    }
  }
}
class Main {
  method run(p: Planner, d: Dancer, e: Eye) : unit !{net, time, log} {
    var z = remote_call("127.0.0.1:9012", "Plan", "reset", "", 2000);
    print("== 1. simulator (Mac)");
    var a = now p.sort(d, e, "127.0.0.1:9010", "sim") timeout 900000 else 0;
    print("== simulator placed at base " ++ a);
    print("== 2. real arm (Xinu board)");
    a = now p.sort(d, e, "192.168.3.101:9010", "real") timeout 900000 else 0;
    print("== real arm placed at base " ++ a);
    print("== done");
  }
}
var d = new Dancer();
var e = new Eye();
var p = new Planner();
var m = new Main();
send m.run(p, d, e);
