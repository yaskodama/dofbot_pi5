// sort.aipl — improved version of complex.aipl: find the green and blue cubes on the table, grasp each, and place green on the right and blue on the left (both cubes).
// First the sim model on the Mac (127.0.0.1:9010), then the real robot (192.168.3.101:9010).
//
// The camera sits above the grasp point (on top of the wrist, 3.2 cm from the finger axis). Pointing the finger axis at the cube
// makes the camera miss it. So color_service.py ("Camera" at 127.0.0.1:9012) provides:
//   locate … shift the arm to aim the camera axis at the cube and take a shot, back-project the color blob's centroid onto the table,
//            re-aim the camera; repeat until it converges (locate.py). Returns the color (green|blue|none).
//   get    … base angle / approach (pre) / grasp pose for grasping that cube (inverse kinematics).
// Repeat until grasped: after lifting, check the finger read-back to see whether the cube is held; if not, search again and re-grasp.
// The fingers close to 145. Measured opening (2026-09-28): 30,50→6.2 70→5.8 90→5.2 110→4.2 131→3.0 135→2.8 cm. A 3 cm cube is touched at 131.
// At 135 (2 mm squeeze) the cube was dropped in transit (2026-09-29), so squeeze hard at 145. If held, the fingers stop near 131; if empty, at 145.
// (At 110 the fingers stayed 4.2 cm open and did not touch the cube.)
// The sim model uses the CG wrist camera, the real robot uses pixels from the Xinu camera; same procedure, same decisions.
// When grasping/placing, lower (color_service) descends from 7 cm above the table in 0.5 cm steps and stops at 2.8 cm above the table (per the sim model's math)
// (lowering to 2.3 cm per the sim model made the real robot hit the table and lift its body; the real fingers are longer than the model's).
// Drop-off spots: 17 cm out at base 150° (right) / 30° (left).
class Dancer {
  // Send one move to the arm. Before/after, push it onto PLAN ("Plan" in color_service) and write back the result
  // → the command list shows up in the Xinu simulator's CG, with the move now executing highlighted.
  method go(b: string, s: string) : int !{net, log} {
    var where = "real";
    if (b == "127.0.0.1:9010") { where = "sim"; }
    var i = remote_call("127.0.0.1:9012", "Plan", "push", where ++ " " ++ s, 2000);
    var res = remote_call(b, "dofbot", "cmd", s, 3000);
    var z = remote_call("127.0.0.1:9012", "Plan", "done", i ++ " " ++ res, 2000);
    print("  " ++ s ++ "  -> " ++ res);
    reply(0);
  }
}
class Eye {
  method locate(mode: string, grip: string) : string !{net, log} {
    var c = remote_call("127.0.0.1:9012", "Camera", "locate", mode ++ " " ++ grip, 180000);   // one sweep + re-check + refinement: 1-2 min
    if (c == "err") { c = "none"; }
    print("  locate(" ++ mode ++ ", grip " ++ grip ++ ") = " ++ c);
    reply(c);
  }
  method lower(mode: string, arg: string) : string !{net, log} {
    var v = remote_call("127.0.0.1:9012", "Camera", "lower", mode ++ " " ++ arg, 45000);
    print("  lower(" ++ arg ++ ") = " ++ v);
    reply(v);
  }
  method held(mode: string) : string !{net, log} {
    var v = remote_call("127.0.0.1:9012", "Camera", "held", mode, 8000);
    print("  held(" ++ mode ++ ") = " ++ v);
    reply(v);
  }
  method get(mode: string, key: string) : string !{net, log} {
    var v = remote_call("127.0.0.1:9012", "Camera", "get", mode ++ " " ++ key, 5000);
    print("  " ++ key ++ " = " ++ v);
    reply(v);
  }
}
class Planner {
  // Repeat search → grasp → place at the color's drop-off spot until both cubes on the table (green and blue) are placed.
  // A placed cube ends up outside the search range (±20° from front), at base 150° / 30°, so the next search won't pick it up.
  method sort(d: Dancer, e: Eye, b: string, mode: string) : int !{net, time, log} {
    var r = 0;
    var placed = 0;
    var tries = 0;
    var base = "90";
    var need = "any";           // color to search for: after placing one, search only for the remaining color (so it won't lock onto other blue objects on the table)
    var misses = 0;             // number of full sweeps that found nothing
    r = now d.go(b, "pose 90 90 90 90 90 30 2600") timeout 5000 else 0; wait(2850);          // upright
    while placed < 2 do {
      if (tries >= 1000) { placed = placed + 100; } else { if (tries >= 30) { placed = 99; } else {
      var c = now e.locate(mode, "30 " ++ need) timeout 200000 else "none";                 // search for a cube (the arm moves too)
      if (c == "none") {
        // A search sweeps the entire reachable range. If nothing is found after placing at least one, none are left
        misses = misses + 1;
        if (placed > 0) { if (misses >= 2) { print("  no more cubes in reach — done"); tries = 1000; }
                          else { print("  try " ++ (tries + 1) ++ ": nothing found — survey once more"); } }
        else { if (misses >= 3) { print("  no cube in reach after 3 surveys"); tries = 1000; }
               else { print("  try " ++ (tries + 1) ++ ": no cube in reach — survey again"); } }
        tries = tries + 1;
      } else {
        base = now e.get(mode, "base") timeout 8000 else "90";
        var pre = now e.get(mode, "pre") timeout 8000 else "59 35 10";
        print("  try " ++ (tries + 1) ++ ": " ++ c ++ " cube at base " ++ base);
        r = now d.go(b, "set 6 30 500") timeout 5000 else 0; wait(700);                                        // open the fingers
        r = now d.go(b, "pose " ++ base ++ " 80 50 50 90 30 2000") timeout 5000 else 0; wait(2250);          // ready pose (P_TOP)
        var y = now e.lower(mode, "here 30") timeout 60000 else "err";                                         // lower from above the cube in 0.5 cm steps
        if (y == "err") {
          print("  try " ++ (tries + 1) ++ ": could not lower — look again");
          r = now d.go(b, "pose " ++ base ++ " 80 50 50 90 30 2000") timeout 5000 else 0; wait(2250);
          tries = tries + 1;
        } else {
          r = now d.go(b, "set 6 145 800") timeout 5000 else 0; wait(1300);                                    // grasp (wait a little after fully closing)
          var h0 = now e.held(mode) timeout 15000 else "err";                                                  // right after closing: is it held?
          r = now d.go(b, "pose " ++ base ++ " " ++ pre ++ " 90 145 2500") timeout 5000 else 0; wait(2750);  // rise slowly along the axis
          r = now d.go(b, "pose " ++ base ++ " 80 50 50 90 145 3000") timeout 5000 else 0; wait(3250);       // lift slowly (P_TOP)
          var h = now e.held(mode) timeout 15000 else "err";                                                   // after lifting: still held?
          if (h0 == "yes") { if (h != "yes") { print("  held when closed, dropped while lifting"); } }
          if (h == "yes") {
            r = now d.go(b, "set 6 140 400") timeout 5000 else 0; wait(650);                                 // once held, loosen slightly (reduces the current from pressing continuously)
            var at = 30;
            if (c == "green") { at = 150; print("  green -> right"); } else { print("  blue -> left"); }
            r = now d.go(b, "pose " ++ at ++ " 80 50 50 90 140 2600") timeout 5000 else 0; wait(2850);       // swing to the drop-off spot
            var y2 = now e.lower(mode, at ++ " 17 140") timeout 60000 else "err";                            // lower onto the drop-off spot in 0.5 cm steps
            r = now d.go(b, "set 6 30 600") timeout 5000 else 0; wait(850);                                   // release
            r = now d.go(b, "pose " ++ at ++ " 80 50 50 90 30 2000") timeout 5000 else 0; wait(2250);        // rise
            placed = placed + 1;
            misses = 0;
            if (c == "green") { need = "blue"; } else { need = "green"; }
            print("  placed " ++ placed ++ " cube(s)");
          } else {
            print("  try " ++ (tries + 1) ++ ": the fingers closed on nothing — open, look again");
            r = now d.go(b, "set 6 30 500") timeout 5000 else 0; wait(700);
          }
          tries = tries + 1;
        }
      }
      }
      }
    }
    r = now d.go(b, "pose 90 90 90 90 90 30 3100") timeout 5000 else 0; wait(3350);                          // back to upright
    if (placed == 99) { print("  gave up after 30 tries"); reply(0); } else { if (placed >= 100) { reply(placed - 100); } else { reply(placed); } }
  }
}
class Main {
  method run(p: Planner, d: Dancer, e: Eye) : unit !{net, time, log} {
    var z = remote_call("127.0.0.1:9012", "Plan", "reset", "", 2000);
    print("== 1. simulator (Mac)");
    var a = now p.sort(d, e, "127.0.0.1:9010", "sim") timeout 900000 else 0;
    print("== simulator placed " ++ a ++ " cube(s)");
    print("== 2. real arm (Xinu board)");
    a = now p.sort(d, e, "192.168.3.101:9010", "real") timeout 900000 else 0;
    print("== real arm placed " ++ a ++ " cube(s)");
    print("== done");
  }
}
var d = new Dancer();
var e = new Eye();
var p = new Planner();
var m = new Main();
send m.run(p, d, e);
