// sort.aipl — complex.aipl の改良版: 卓上の緑と青の立方体を探して挟み、緑は右・青は左に置く（2 つとも）。
// まず Mac の模型（127.0.0.1:9010）、次に実機（192.168.3.101:9010）。
//
// カメラは挟む所の上（手首の上面、指の軸から 3.2 cm）に付いている。指の軸を立方体に向けると
// カメラは立方体を外れる。そこで color_service.py（127.0.0.1:9012 の "Camera"）に:
//   locate … 腕をずらしてカメラの軸を立方体へ向けて撮り、色の塊の重心を卓上へ逆射影し、
//            カメラを向け直す、を収束まで繰り返す（locate.py）。答えは色（green|blue|none）。
//   get    … その立方体を挟む 土台の角度 / 手前 / 挟む 姿勢（逆運動学）。
// 挟めるまで繰り返す: 持ち上げたあとに指の読み戻しで挟めたか確かめ、挟めていなければ探し直して挟み直す。
// 指は 145 まで閉じる。実測の幅（2026-09-28）: 30,50→6.2 70→5.8 90→5.2 110→4.2 131→3.0 135→2.8 cm。3 cm の立方体は 131 で触れる。
// 135（2 mm 押さえ）では運ぶ途中で落とした（2026-09-29）ので 145 で強く押さえる。挟めていれば 131 付近で止まり、空なら 145。
// （110 では 4.2 cm 開いたままで、立方体に触れていなかった）
// 模型は CG の手首カメラ、実機は Xinu のカメラの画素で、同じ手順・同じ判定。
// 挟む・置くときは lower（color_service）で卓上 7 cm から 0.5 cm ずつ降ろし、模型の計算で卓上 2.8 cm で止める
// （模型で 2.3 cm まで下げると実機は卓に当たって本体が浮いた。実機の指は模型より長い）。
// 置き場は土台 150°（右）/ 30°（左）の前 17 cm。
class Dancer {
  // 腕へ 1 手送る。前後で PLAN（color_service の "Plan"）に積んで結果を書き戻す
  // → Xinu シミュレータの CG に命令の列が出て、いま実行中の手が反転する。
  method go(b: string, s: string) : int !{net, log} {
    var where = "real";
    if (b == "127.0.0.1:9010") { where = "sim"; }
    var i = remote_call("127.0.0.1:9012", "Plan", "push", where ++ " " ++ s, 2000);
    var res = remote_call(b, "dofbot", "cmd", s, 3000);
    var z = remote_call("127.0.0.1:9012", "Plan", "done", i ++ " " ++ res, 2000);
    print("  " ++ s ++ "  -> " ++ res);
    reply(0);
  }
}
class Eye {
  method locate(mode: string, grip: string) : string !{net, log} {
    var c = remote_call("127.0.0.1:9012", "Camera", "locate", mode ++ " " ++ grip, 180000);   // 一巡＋見直し＋詰めで 1〜2 分
    if (c == "err") { c = "none"; }
    print("  locate(" ++ mode ++ ", grip " ++ grip ++ ") = " ++ c);
    reply(c);
  }
  method lower(mode: string, arg: string) : string !{net, log} {
    var v = remote_call("127.0.0.1:9012", "Camera", "lower", mode ++ " " ++ arg, 45000);
    print("  lower(" ++ arg ++ ") = " ++ v);
    reply(v);
  }
  method held(mode: string) : string !{net, log} {
    var v = remote_call("127.0.0.1:9012", "Camera", "held", mode, 8000);
    print("  held(" ++ mode ++ ") = " ++ v);
    reply(v);
  }
  method get(mode: string, key: string) : string !{net, log} {
    var v = remote_call("127.0.0.1:9012", "Camera", "get", mode ++ " " ++ key, 5000);
    print("  " ++ key ++ " = " ++ v);
    reply(v);
  }
}
class Planner {
  // 卓上の立方体（緑と青の 2 つ）を、両方とも置き終わるまで 探す → 挟む → 色の置き場へ置く を繰り返す。
  // 置いた立方体は探す範囲（正面から ±20°）の外（土台 150° / 30°）に出るので、次の探索では拾わない。
  method sort(d: Dancer, e: Eye, b: string, mode: string) : int !{net, time, log} {
    var r = 0;
    var placed = 0;
    var tries = 0;
    var base = "90";
    var need = "any";           // 探す色: 1 つ置いたら残りの色だけを探す（卓上の他の青い物に固定されないように）
    var misses = 0;             // 範囲を一巡して見つからなかった回数
    r = now d.go(b, "pose 90 90 90 90 90 30 2600") timeout 5000 else 0; wait(2850);          // 直立
    while placed < 2 do {
      if (tries >= 1000) { placed = placed + 100; } else { if (tries >= 30) { placed = 99; } else {
      var c = now e.locate(mode, "30 " ++ need) timeout 200000 else "none";                 // 立方体を探す（腕も動く）
      if (c == "none") {
        // 探索は手の届く範囲をもれなく一巡する。1 つ以上置いた後に見つからなければ、もう残っていない
        misses = misses + 1;
        if (placed > 0) { print("  no more cubes in reach — done"); tries = 1000; }
        else { if (misses >= 3) { print("  no cube in reach after 3 surveys"); tries = 1000; }
               else { print("  try " ++ (tries + 1) ++ ": no cube in reach — survey again"); } }
        tries = tries + 1;
      } else {
        base = now e.get(mode, "base") timeout 8000 else "90";
        var pre = now e.get(mode, "pre") timeout 8000 else "59 35 10";
        print("  try " ++ (tries + 1) ++ ": " ++ c ++ " cube at base " ++ base);
        r = now d.go(b, "set 6 30 500") timeout 5000 else 0; wait(700);                                        // 指を開く
        r = now d.go(b, "pose " ++ base ++ " 80 50 50 90 30 2000") timeout 5000 else 0; wait(2250);          // 構え（P_TOP）
        var y = now e.lower(mode, "here 30") timeout 60000 else "err";                                         // 立方体の上から 0.5 cm ずつ降ろす
        if (y == "err") {
          print("  try " ++ (tries + 1) ++ ": could not lower — look again");
          r = now d.go(b, "pose " ++ base ++ " 80 50 50 90 30 2000") timeout 5000 else 0; wait(2250);
          tries = tries + 1;
        } else {
          r = now d.go(b, "set 6 145 800") timeout 5000 else 0; wait(1300);                                    // 挟む（閉じ切ってから少し待つ）
          var h0 = now e.held(mode) timeout 15000 else "err";                                                  // 閉じた直後: 挟んでいるか
          r = now d.go(b, "pose " ++ base ++ " " ++ pre ++ " 90 145 2500") timeout 5000 else 0; wait(2750);  // 軸に沿ってゆっくり上がる
          r = now d.go(b, "pose " ++ base ++ " 80 50 50 90 145 3000") timeout 5000 else 0; wait(3250);       // ゆっくり持ち上げる（P_TOP）
          var h = now e.held(mode) timeout 15000 else "err";                                                   // 持ち上げた後: まだ挟んでいるか
          if (h0 == "yes") { if (h != "yes") { print("  held when closed, dropped while lifting"); } }
          if (h == "yes") {
            var at = 30;
            if (c == "green") { at = 150; print("  green -> right"); } else { print("  blue -> left"); }
            r = now d.go(b, "pose " ++ at ++ " 80 50 50 90 145 2600") timeout 5000 else 0; wait(2850);       // 置き場へ回す
            var y2 = now e.lower(mode, at ++ " 17 145") timeout 60000 else "err";                            // 置き場へ 0.5 cm ずつ降ろす
            r = now d.go(b, "set 6 30 600") timeout 5000 else 0; wait(850);                                   // 放す
            r = now d.go(b, "pose " ++ at ++ " 80 50 50 90 30 2000") timeout 5000 else 0; wait(2250);        // 上がる
            placed = placed + 1;
            if (c == "green") { need = "blue"; } else { need = "green"; }
            print("  placed " ++ placed ++ " cube(s)");
          } else {
            print("  try " ++ (tries + 1) ++ ": the fingers closed on nothing — open, look again");
            r = now d.go(b, "set 6 30 500") timeout 5000 else 0; wait(700);
          }
          tries = tries + 1;
        }
      }
      }
      }
    }
    r = now d.go(b, "pose 90 90 90 90 90 30 3100") timeout 5000 else 0; wait(3350);                          // 直立に戻る
    if (placed == 99) { print("  gave up after 30 tries"); reply(0); } else { if (placed >= 100) { reply(placed - 100); } else { reply(placed); } }
  }
}
class Main {
  method run(p: Planner, d: Dancer, e: Eye) : unit !{net, time, log} {
    var z = remote_call("127.0.0.1:9012", "Plan", "reset", "", 2000);
    print("== 1. simulator (Mac)");
    var a = now p.sort(d, e, "127.0.0.1:9010", "sim") timeout 900000 else 0;
    print("== simulator placed " ++ a ++ " cube(s)");
    print("== 2. real arm (Xinu board)");
    a = now p.sort(d, e, "192.168.3.101:9010", "real") timeout 900000 else 0;
    print("== real arm placed " ++ a ++ " cube(s)");
    print("== done");
  }
}
var d = new Dancer();
var e = new Eye();
var p = new Planner();
var m = new Main();
send m.run(p, d, e);
