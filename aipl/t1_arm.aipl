// t1 — from the reference implementation (Mac) to the DOFBOT's Xinu board. arm_cmd is forwarded to the board's /arm endpoint (io).
class Tester {
  method run() : unit !{io, log} {
    print("stat: " ++ arm_cmd("stat"));
    print("read: " ++ arm_cmd("read"));
    print("rgb:  " ++ arm_cmd("rgb 255 0 0"));
    print("pose: " ++ arm_cmd("pose 90 90 90 90 90 30 1500"));
  }
}
var t = new Tester();
send t.run();
